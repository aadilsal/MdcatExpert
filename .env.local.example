# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Resend (Next.js contact / notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=MdcatXpert <onboarding@resend.dev>

# Convex dashboard (Settings → Environment Variables) — required for password reset OTP
# AUTH_RESEND_KEY=          # same value as RESEND_API_KEY is fine
# RESEND_FROM_EMAIL=        # set on Convex too if different from Next

# Public site URL (SEO: sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=https://mdcatxpert.com

# Study Copilot RAG (Groq only — chat + retrieval uses Convex full-text search)
GROQ_API_KEY=

# Scanned PDF OCR — Convex calls this Next.js route (works on Vercel).
# Set INGEST_OCR_SECRET + SITE_URL in Convex dashboard too (SITE_URL = your public app URL).
INGEST_OCR_SECRET=
SITE_URL=http://localhost:3000
