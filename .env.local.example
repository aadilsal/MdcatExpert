# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Resend — set on Vercel (Next.js) for contact form, payment emails, notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=MdcatXpert <onboarding@mdcatxpert.com>
ADMIN_EMAIL=salmanaadil52@gmail.com

# Convex dashboard (Settings → Environment Variables) — required for password reset OTP only
# AUTH_RESEND_KEY=          # same Resend API key as RESEND_API_KEY
# RESEND_FROM_EMAIL=MdcatXpert <onboarding@mdcatxpert.com>

# Public site URL (SEO: sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=https://mdcatxpert.com

# Study Copilot RAG (Groq only — chat + retrieval uses Convex full-text search)
GROQ_API_KEY=

# Scanned PDF OCR — Convex calls this Next.js route (works on Vercel).
# Set INGEST_OCR_SECRET + SITE_URL in Convex dashboard too (SITE_URL = your public app URL).
INGEST_OCR_SECRET=
SITE_URL=http://localhost:3000

# Safepay (automated Elite checkout — replaces the manual JazzCash screenshot flow)
# Get sandbox keys at https://sandbox.api.getsafepay.com/dashboard/login, live keys
# (after KYC approval) at https://getsafepay.com/dashboard/login.
SAFEPAY_ENV=sandbox
SAFEPAY_SECRET_KEY=
SAFEPAY_API_KEY=
# From Safepay Dashboard -> Developers -> Endpoints -> (your endpoint) -> View shared secret.
# Register the endpoint URL as https://<your-domain>/api/webhooks/safepay and subscribe to
# at least payment.succeeded and payment.failed.
SAFEPAY_WEBHOOK_SECRET=
# A random string you generate yourself (e.g. `openssl rand -hex 32`). Must be set to the
# SAME value in BOTH this file/Vercel AND the Convex dashboard's environment variables —
# it's how the Safepay webhook route proves to Convex it's allowed to activate premium.
GATEWAY_WEBHOOK_SHARED_SECRET=
